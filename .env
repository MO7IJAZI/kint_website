# Environment Variables
# NOTE: For production (Hostinger), set these in the Dashboard -> Node.js -> Environment Variables
# or update this file with your production values (NOT RECOMMENDED to commit real secrets to Git)

# Database
DATABASE_URL="mysql://user:password@localhost:3306/kint_db"

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change_this_to_a_secure_random_string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
