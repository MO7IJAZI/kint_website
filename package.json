{
  "name": "kint-website",
  "description": "Next.js (App Router) website for KINT",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "nextjs",
    "react",
    "prisma",
    "mysql"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "hostinger:deploy": "bash fix-hostinger.sh",
    "hostinger:test": "node -e \"const { PrismaClient } = require('@prisma/client'); const prisma = new PrismaClient(); prisma.\\$queryRawUnsafe('SELECT 1').then(() => console.log('✅ DB OK')).catch((e) => console.log('❌ DB Error:', e.message)).finally(() => prisma.\\$disconnect());\"",
    "prisma:fix": "rm -rf node_modules/.prisma && npx prisma generate --no-engine",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@types/lodash.debounce": "^4.0.9",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "html-react-parser": "^5.2.13",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.563.0",
    "mysql2": "^3.15.1",
    "@prisma/client": "5.16.0",
    "prisma": "5.16.0",
    "next": "^16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
